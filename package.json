{
  "name": "evolutility-models",
  "version": "0.3.0",
  "type": "module",
  "description": "Models for Evolutility",
  "license": "MIT",
  "homepage": "https://github.com/evoluteur/evolutility-models",
  "author": "Olivier Giulieri (https://evoluteur.github.io/)",
  "copyright": "(c) 2026 Olivier Giulieri",
  "repository": {
    "type": "git",
    "url": "git://github.com/evoluteur/evolutility-models.git"
  },
  "scripts": {
    "codegen:db": "tsx scripts/build-db.ts && tsx scripts/build-db-models.ts && tsx scripts/build-db-users.ts",
    "codegen:db:models": "tsx scripts/build-db-models.ts",
    "codegen:db:users": "tsx scripts/build-db-users.ts",
    "models:pull": "tsx scripts/models-pull.ts",
    "codegen": "npm run codegen:db",
    "typecheck": "tsc --noEmit"
  },
  "bugs": "https://github.com/evoluteur/evolutility-models/issues",
  "keywords": [
    "model",
    "CRUD",
    "low-code",
    "platform",
    "framework",
