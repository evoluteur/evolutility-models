    "swagger",
    "MDA",
    "ORM",
    "metadata",
    "metamodel",
    "codegen",
    "generator",
    "typescript",
    "evolutility"
  ],
  "dependencies": {
    "prettier": "^3.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.21.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
